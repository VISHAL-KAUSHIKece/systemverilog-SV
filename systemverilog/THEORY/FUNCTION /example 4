/* Write a SystemVerilog function that takes an array of 8 integers as input and returns the number of elements that are greater than the average of the array. */

module g;
int a[8];

function  int g_t(input int a[8]);
int sum = 0;
 real av =0;
 int no_greater = 0;
foreach(a[j]) begin
  sum += a[j]; end
  
  av = sum/8;
  
 foreach(a[j]) begin 
   if(av < a[j]) 
 no_greater++;

 end 
  $display(" av= %0d",av);
 return no_greater;
 endfunction

 initial begin 
 int result ;
 foreach (a[i]) begin

 a[i]  = $urandom_range(1,15);
 $display(" a[%0d] = %0d",i,a[i]);
 end
result = g_t(a);
$display(" no. of greater values then average = %0d",result);
end 
endmodule
