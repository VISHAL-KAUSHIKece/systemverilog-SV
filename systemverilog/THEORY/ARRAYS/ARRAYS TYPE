// DYNAMIC ARRAY   * Function int size(), function void delete(), new[ ] *

module eg;
int a[];

initial begin

a = new[3];
a = '{1,2,3};

foreach (a[i])  $display ("a[%0d]=%0d",i,a[i]);  // print the value

     $display ("a size is =%0d",a.size()); // size of array 


     a = new[5](a);   // Function int size()    privious values of "a" are also present
     $display ("a size is =%0d",a.size());  
  
foreach (a[i])  $display ("a[%0d]=%0d",i,a[i]);  // print the new value for a[5] including previous values and new values are 0s


     a = new[7];  // new[ ] 
    $display ("a size is =%0d",a.size());  
  
foreach (a[i])  $display ("a[%0d]=%0d",i,a[i]);  // all the values will be 0 

    a.delete();  // function void delete()
    $display ("a size is =%0d",a.size());   // size if a become  0 

end
endmodule
  
